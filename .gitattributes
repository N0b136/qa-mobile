# Normalize all text to LF in the repo and check out LF on every platform.
# This stops Git's "LF will be replaced by CRLF" warnings on Windows and keeps
# diffs clean across machines.
* text=auto eol=lf

# Binary assets — never apply line-ending or text conversion to these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
*.xlsx  binary
*.docx  binary
*.mp4   binary
*.webm  binary
