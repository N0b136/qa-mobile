rules_version = '2';

// Questland Firestore rules.
//
// Deploy from the Firebase console (Firestore > Rules > paste > Publish) for the
// qa-mobile-36a9c project. Nothing here is bundled into the app — the web config
// in src/services/firebaseConfig.ts is public by design and these rules are the
// only thing standing between it and the data.
//
// Three tiers of caller reach this database:
//   • a REAL guest — signed in with email/password, request.auth.uid IS their
//     User.id. Everything owner-scoped below keys off that equality.
//   • STAFF — a guest-shaped account that also has a staff/{uid} doc. Only
//     staff can see the whole calls board, send word to other people, or
//     schedule anything. That doc is the entire authorisation model.
//   • an ANONYMOUS session — a phone that fell back to a local-only account.
//     It can reach nothing that belongs to anybody. This is intentional.
//
// Consequence worth knowing: a local-only fallback account (created while the
// Email/Password provider was off, or while offline) has no validated identity,
// so its bookings and progress simply do not sync. That is the intended
// outcome, not a bug — unvalidated accounts stay on their device.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A validated guest or staff member — NOT the anonymous bootstrap session.
    //
    // Anonymous is a fallback identity anybody can mint from the public web
    // config, so it must never own data. Nothing in the app needs it to: a real
    // guest signs in with email/password, a local-only fallback account has an
    // id that is not a uid (so it could never satisfy an owner check anyway),
    // and cloudSync refuses to attach a single listener until the session is
    // non-anonymous. The anonymous session exists only to bootstrap Firebase.
    function isRealUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isSelf(uid) {
      return isRealUser() && request.auth.uid == uid;
    }

    // Staff are an allowlist, not a claim the client can assert. exists() is a
    // server-side lookup, so it is not subject to the read rule below.
    //
    // isRealUser(), not signedIn(): isStaff() is now the most powerful predicate
    // in this file — it writes other people's presence, progress and legs — so
    // it must never be satisfiable by a session anybody can mint.
    function isStaff() {
      return isRealUser() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    // The doc must be filed under the id it claims. Every push already writes
    // this field, so a staff write cannot plant a row under the wrong guest.
    function selfFiled(uid) {
      return request.resource.data.userId == uid;
    }

    function ownsExisting() {
      return isRealUser() && resource.data.userId == request.auth.uid;
    }

    function ownsIncoming() {
      return isRealUser() && request.resource.data.userId == request.auth.uid;
    }

    // The seeded demo cast. `demo-` ids cannot collide with a Firebase uid, so
    // these two grant nothing over a real guest's data — they exist only so the
    // presenter's /demo remote can stage a world. Drop them for production.
    function demoIncoming() {
      return isRealUser() && request.resource.data.userId.matches('demo-.*');
    }

    function demoExisting() {
      return isRealUser() && resource.data.userId.matches('demo-.*');
    }

    // The staff roster. Provisioned BY HAND from the Firebase console — no
    // client may write here, so nobody can promote themselves.
    match /staff/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // ── Guest-owned data ────────────────────────────────────────────────────

    // Private profile — the only place an email is stored. Never readable by
    // anyone else, including the console.
    match /accounts/{uid} {
      allow read, write: if isSelf(uid);
    }

    // Public directory: name, avatar, order, party, level. Deliberately carries
    // no email, because every signed-in client reads it to render rosters,
    // the leaderboard and the console's guest list.
    //
    // The `demo-` exception is what lets the presenter's /demo console seed its
    // cast into the console roster. It is scoped to ids that cannot collide with
    // a Firebase uid, so it grants nothing over a real guest's row.
    //
    // The `walk-` clause is the ticket booth enrolling a group who arrived with
    // no phone between them. That record has no credential and never will, so
    // nobody can ever sign in to write it — if staff cannot, nobody can, and the
    // party is invisible to the console, the park chart and the day's log the
    // moment they walk away from the counter. Tighter than the demo exception on
    // both sides: STAFF only, and the document must say what it is, so a guest
    // cannot mint one and no ordinary row can hide behind the prefix.
    match /guests/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid)
        || (isRealUser() && uid.matches('demo-.*'))
        || (isStaff() && uid.matches('walk-.*') && request.resource.data.walkUp == true);
    }

    // Read-for-all so party rosters and the leaderboard can rank other guests;
    // only you can advance your own questlines.
    match /progress/{uid} {
      allow read: if signedIn();
      // The console is the writer of record for an RFID tap: under the canopy no
      // phone saw it. pushProgress unions the SERVER copy with the local one
      // inside a transaction, and episodes are only ever added, so neither
      // writer can erase the other's work. Delete stays owner-only.
      allow create, update: if (isSelf(uid) || isStaff()) && request.resource.data.id == uid;
      allow delete: if isSelf(uid);
    }

    // Passages. Only the guest who bought one may change or cancel it — but the
    // booth spends a Quest Experience off a passage bought in the app, so staff
    // must be able to see what was bought before they spend against it.
    match /bookings/{bookingId} {
      allow read: if isStaff() || ownsExisting();
      allow update, delete: if ownsExisting();
      // Staff create ONLY for a walk-up. A group who arrived with no phone is
      // sold their passage at the counter, and the record has to be filed under
      // the walk-up's own id for passStates/redeem to read it — but that id has
      // no credential, so ownsIncoming() can never be satisfied for it and the
      // booking would live and die in one browser tab. Narrower than the guests
      // clause above: staff may file a booking for a walk-up and for nobody
      // else, so a real guest's passages stay theirs alone to create.
      allow create: if ownsIncoming()
        || (isStaff() && request.resource.data.userId.matches('walk-.*'));
    }

    // The passage ledger. It stopped being device-local when the gate became the
    // place a Passage is spent: the booth spends on behalf of a guest whose phone
    // is in their pocket. Uses are IMMUTABLE once written and the merge is a union
    // by id, so neither the phone nor the booth can erase the other's spend.
    // Delete stays owner-only.
    match /passUses/{uid} {
      allow read: if isSelf(uid) || isStaff();
      allow create, update: if (isSelf(uid) || isStaff()) && request.resource.data.id == uid;
      allow delete: if isSelf(uid);
    }

    // Station check-ins. Readable by every VALIDATED client — a party member's
    // phone needs the whole board to notice it has been carried along with the
    // party, and the console's park map reads all of it. Anonymous is excluded
    // on both sides: these rows carry guest names and locations, and nothing in
    // the app reads them before a real session exists.
    //
    // WRITE IS OWN-ROW ONLY, which is what makes party check-in safe: nobody can
    // plant another guest at a station. When one member taps in, each other
    // member's device adopts that check-in and writes its OWN row.
    // STAFF WRITE is the RFID path: a party taps a flagpole at a plinth in the
    // woods and no phone is involved at all, so the console writes every
    // member's row itself. `selfFiled` keeps that honest — the document must
    // carry the uid it is filed under, so even staff cannot plant a guest under
    // somebody else's name.
    match /presence/{uid} {
      allow read: if isRealUser();
      allow create, update: if (isSelf(uid) || isStaff() || (isRealUser() && uid.matches('demo-.*')))
                               && selfFiled(uid);
      // request.resource does not exist on a delete, so selfFiled() cannot apply
      // there. Racking a standard clears the whole party's rows.
      allow delete: if isSelf(uid) || isStaff() || (isRealUser() && uid.matches('demo-.*'));
    }

    // The station records: an append-only log of every leg walked, kept after
    // the party has gone home. This is the operations record the Back Office
    // exports at the end of the day, so STAFF read all of it and nobody edits
    // any of it — a leg is written once, by the phone that tapped, and revised
    // never. A guest reaches only their own rows, which is all a demo reset
    // needs to clear up after itself.
    match /legs/{id} {
      // Staff create, because a flag tap is recorded by the console rather than
      // by anybody's phone. UPDATE STAYS SHUT TO EVERYBODY: the whole value of
      // the export is that a leg still means what it meant when it was written.
      allow create: if isStaff() || ownsIncoming() || demoIncoming();
      allow read, delete: if isStaff() || ownsExisting() || demoExisting();
      allow update: if false;
    }

    // The standards. A party takes a pole from the rack, a Guide binds it to
    // their party, their quest and a spent Passage, and tapping a reader at a
    // station IS the check-in. The record is the entire binding — the tag in the
    // pole's tip carries a factory uid and nothing else.
    //
    // READ IS UNGATED ON THE DOCUMENT'S OWN FIELDS, ON PURPOSE. A phone
    // subscribes with where('memberIds','array-contains', uid), and a rule that
    // reads resource.data would refuse that QUERY outright — the filter alone
    // does not prove every match satisfies the rule. Firestore never retries a
    // listener it refused, so tightening this does not degrade the guest's view
    // of their own standard, it kills it permanently. Do not "fix" it.
    //
    // Write is the booth's alone. Nobody binds their own standard.
    match /flags/{tagUid} {
      allow read:  if isRealUser();
      allow write: if isStaff();
    }

    // ── Parties ─────────────────────────────────────────────────────────────

    // The code doc is the join lookup, so any signed-in guest may read it. It is
    // claimed on create and released when the last member leaves.
    match /partyCodes/{code} {
      allow read, create, delete: if isRealUser();
    }

    // isStaff() runs alongside every guest clause here because the ticket booth
    // makes a party ON BEHALF OF guests who are not holding a phone. A walk-up
    // record can never sign in, so the "only you may add or remove yourself"
    // rule has nobody to be satisfied by: without this, a walk-up family walks
    // as a lone traveller — occupants() groups the park by party, and the board,
    // the chart and the day's log would each show one guest instead of five.
    match /parties/{partyId} {
      allow read: if signedIn();
      allow create: if isStaff()
        || (isRealUser() && request.auth.uid in request.resource.data.memberIds);

      // A guest may add or remove ONLY themselves. Renaming is open to members
      // and must leave the roster untouched. Nobody can conscript or evict
      // anyone else.
      allow update: if isStaff() || (isRealUser() && (
        request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet())
          == [request.auth.uid].toSet()
        || resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet())
          == [request.auth.uid].toSet()
        || (request.auth.uid in resource.data.memberIds
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet())
      ));

      // Only the last member out can strike the party — or staff, who put the
      // walk-up party there in the first place and are the only ones who can
      // clear one up.
      allow delete: if isStaff()
        || (isRealUser() && resource.data.memberIds.toSet() == [request.auth.uid].toSet());
    }

    // ── Comm lanes (guest phone <-> Back Office console) ────────────────────
    //
    // A guest reaches only their own calls and their own inbox. Seeing every
    // call, writing into somebody else's inbox, and scheduling are all staff
    // powers, gated on the staff/{uid} allowlist above.

    // A guest raises and stands down their own calls; staff see the whole
    // board and dispatch against it.
    match /sos/{id} {
      allow create: if ownsIncoming() || demoIncoming();
      allow read, update, delete: if isStaff() || ownsExisting() || demoExisting();
    }

    // A guest's own device writes its own notifications (bookings, lore,
    // rank-ups, reminders). Only staff may address anybody else.
    match /notifications/{id} {
      allow read: if ownsExisting();
      allow create: if isStaff() || ownsIncoming();
      allow update, delete: if isStaff() || ownsExisting();
    }

    // Scheduled sends are authored and fired by the console alone.
    match /scheduled/{id} {
      allow read, write: if isStaff();
    }

    // The notice board. The same proclamations for the whole park, so every
    // signed-in client reads them; only the Back Office nails one up. This is
    // the one comm lane that is deliberately public on the read side — a notice
    // in the village square is not addressed to anybody in particular.
    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
